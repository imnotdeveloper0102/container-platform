# Copy to .env before running: cp .env.example .env
# All values here are placeholders only — replace them before real use.
# Never commit a real .env with real passwords.

# PostgreSQL
POSTGRES_USER=secuser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sec_events
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE=events:queue
REDIS_PORT=6379

# collector-go
COLLECTOR_HTTP_PORT=8080
COLLECTOR_TCP_PORT=9000
WORKER_COUNT=8
QUEUE_BUFFER=1000
PUSH_TIMEOUT_MS=2000

# analyzer-python
ANALYZER_PORT=8000
REDIS_PROCESSING_QUEUE=events:processing
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=300
PORT_SCAN_THRESHOLD=5
PORT_SCAN_WINDOW_SECONDS=60
ALERT_COOLDOWN_SECONDS=3600

# api-node (placeholders only — replace before real use; JWT_SECRET is
# required or the service refuses to start, and login is disabled
# unless API_ADMIN_USER / API_ADMIN_PASSWORD are set)
API_PORT=3000
API_ADMIN_USER=admin
API_ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-long-random-secret
JWT_EXPIRES_IN=1h
WS_POLL_INTERVAL_MS=2000

# dashboard-ts (placeholders only — empty means the dashboard calls
# relative /api and /ws, which nginx proxies to api-node:3000)
DASHBOARD_PORT=8081
VITE_API_URL=
VITE_WS_URL=

# admin-php (placeholders only — replace before real use; ADMIN_USER /
# ADMIN_PASSWORD chỉ dùng để seed tài khoản đầu tiên khi bảng app_users
# còn trống, không đặt thì chưa ai đăng nhập được)
ADMIN_PORT=8082
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_SECURE=0
